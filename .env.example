# Copier en .env puis compléter. Aucune de ces valeurs n'est secrète :
# elles finissent dans le site public.

# Adresse publique du site (canonical, og:url, sitemap.xml)
SITE_URL=

# Facultatif — envoi direct du formulaire « Démarrer un projet ».
# Sans ces valeurs, le formulaire ouvre la messagerie du visiteur avec la demande pré-remplie.
# Formspree : VITE_FORM_ENDPOINT=https://formspree.io/f/xxxxxxx
# Web3Forms : VITE_FORM_ENDPOINT=https://api.web3forms.com/submit + VITE_FORM_ACCESS_KEY=...
VITE_FORM_ENDPOINT=
VITE_FORM_ACCESS_KEY=
